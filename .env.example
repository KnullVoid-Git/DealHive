# DealHive Production Environment Configuration Template
# Copy this file to '.env' at the root of the project and populate with your credentials

# 1. Supabase Cloud Configuration
VITE_SUPABASE_URL=https://your-supabase-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-public-key

# 2. Stripe Connect Configuration
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_yourStripePublishableKey
VITE_STRIPE_CONNECT_CLIENT_ID=ca_yourStripeConnectClientId

# 3. Dropbox Sign (HelloSign) Configuration
VITE_HELLOSIGN_CLIENT_ID=your_dropbox_sign_client_id

# 4. Google Developer Console Configuration (YouTube Data API v3 OAuth)
VITE_GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
VITE_GOOGLE_REDIRECT_URI=http://localhost:5173/profile
